struct HitRecord {
    vec3 p;
    vec3 normal;
    float t;
    bool frontFace;
    int material;
};

void setFaceNormal(Ray r, vec3 outwardNormal, inout HitRecord record) {
    record.frontFace = dot(r.direction, outwardNormal) < 0.0;
    record.normal = record.frontFace ? outwardNormal : -outwardNormal;
}

/*
 * Interval and utils
 */
struct Interval {
    float min;
    float max;
};
float intervalSize(Interval interval) {
    return interval.max - interval.min;
}
bool intervalContains(Interval interval, float value){
    return interval.min <= value && value <= interval.max;
}
bool intervalSurrounds(Interval interval, float value){
    return interval.min < value && value < interval.max;
}
float intervalClamp(Interval interval, float value) {
    return clamp(value, interval.min, interval.max);
}

bool nearZero(vec3 value) {
    return all(lessThan(abs(value), vec3(EPSILON)));
}
uint rngState;
uint pcgHash(uint inputValue) {
    uint state = inputValue * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}
float randomFloat() {
    rngState = pcgHash(rngState);
    return float(rngState >> 8u) * (1.0 / 16777216.0);
}
vec3 randomVec3(){
    return vec3(randomFloat(), randomFloat(), randomFloat());
}
vec3 randomVec3(float min, float max) {
    return vec3(mix(min, max, randomFloat()),
            mix(min, max, randomFloat()),
            mix(min, max, randomFloat())
    );
}
vec3 randomUnitVector() {
    for (int attempt = 0; attempt < 64; ++attempt) {
        vec3 p = randomVec3(-1.0, 1.0);
        float lengthSquared = dot(p, p);
        if (lengthSquared > EPSILON && lengthSquared <= 1.0) {
            return p / sqrt(lengthSquared);
        }
    }
    return vec3(1.0, 0.0, 0.0);
}
vec3 randomOnHemisphere(vec3 normal) {
    vec3 onUnitSphere = randomUnitVector();
    if (dot(onUnitSphere, normal) > 0.0) {
        return onUnitSphere;
    }
    return -onUnitSphere;
}
vec2 randomInUnitDisk() {
    for (int attempt = 0; attempt < 64; ++attempt)
    {
        vec2 p = vec2(
                2.0 * randomFloat() - 1.0,
                2.0 * randomFloat() - 1.0
        );

        if (dot(p, p) < 1.0)
        {
            return p;
        }
    }

    return vec2(0.0);
}
vec2 sampleSquare() {
    return vec2(
            randomFloat() - 0.5,
            randomFloat() - 0.5
    );
}


vec3 emitted(Material material){
    return material.emission * material.emissionStrength;
}
bool scatterLambertian(Ray r_in, HitRecord rec, Material material, out vec3 attenuation, out Ray scattered) {
    vec3 scatter_direction = rec.normal + randomUnitVector();
    if (nearZero(scatter_direction)) {
        scatter_direction = rec.normal;
    }
    scattered.origin = rec.p;
    scattered.direction = scatter_direction;
    attenuation = material.albedo;
    return true;
}
bool scatterMetal(Ray r_in, HitRecord rec, Material material, out vec3 attenuation, out Ray scattered) {
    vec3 reflected = reflect(normalize(r_in.direction), rec.normal);
    float fuzz = clamp(material.fuzz, 0.0, 1.0);
    scattered = Ray(rec.p, reflected);
    scattered.direction = reflected + fuzz * randomUnitVector();
    attenuation = material.albedo;
    return (dot(scattered.direction, rec.normal) > 0);
}
float reflectance(float cosine, float refractionIndex) {
    // Schlick's approximation
    float r0 = (1.0 - refractionIndex) / (1.0 + refractionIndex);
    r0 *= r0;
    return r0 + (1.0 - r0) * pow(1.0 - cosine, 5.0);
}
bool scatterDielectric(Ray r_in, HitRecord rec, Material material, out vec3 attenuation, out Ray scattered) {
    attenuation = vec3(1.0);
    float ri = rec.frontFace ? (1.0 / material.refractionIndex) : material.refractionIndex;
    vec3 unitDirection = normalize(r_in.direction);
    float cosTheta = min(dot(-unitDirection, rec.normal), 1.0);
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
    bool cannotRefract = ri * sinTheta > 1.0;
    vec3 direction;
    if (cannotRefract || reflectance(cosTheta, ri) > randomFloat()) {
        direction = reflect(unitDirection, rec.normal);
    } else {
        direction = refract(unitDirection, rec.normal, ri);
    }
    scattered = Ray(rec.p, direction);
    return true;
}

vec3 fresnelSchlick(float cosTheta, vec3 F0) {
    return F0 + (vec3(1.0) - F0) * pow(1.0 - clamp(cosTheta, 0.0, 1.0), 5.0);
}
float luminance(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}
vec3 offsetRayOrigin(HitRecord rec, vec3 direction) {
    const float RAY_EPSILON = 0.001;
    float side = dot(direction, rec.normal) >= 0.0 ? 1.0 : -1.0;
    return rec.p + rec.normal * side * RAY_EPSILON;
}
bool scatterPbrMetallicRoughness(Ray rayIn, HitRecord rec, Material material, out vec3 attenuation, out Ray scattered) {
    float metallic = clamp(material.metallic, 0.0, 1.0);
    float roughness = clamp(material.roughness, 0.01, 1.0);
    float transmission = clamp(material.transmission, 0.0, 1.0);

    float transmissionProbability = transmission * (1.0 - metallic);
    if (transmissionProbability > 0.0 && randomFloat() < transmissionProbability) {
        attenuation = vec3(1.0);
        float ri = rec.frontFace? (1.0 / material.refractionIndex) : material.refractionIndex;
        vec3 unitDirection = normalize(rayIn.direction);
        float cosTheta = min(dot(-unitDirection, rec.normal), 1.0);

        float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
        bool cannotRefract = ri * sinTheta > 1.0;
        vec3 direction;
        if (cannotRefract || reflectance(cosTheta, ri) > randomFloat()) {
            direction = reflect(unitDirection, rec.normal);
        } else {
            direction = refract(unitDirection, rec.normal, ri);
        }
        scattered = Ray(offsetRayOrigin(rec, direction), direction);
        return true;
    }

    vec3 V = normalize(-rayIn.direction);
    float NoV = max(dot(rec.normal, V), 0.0);

    vec3 F0 = mix(vec3(0.04), material.albedo, metallic);
    vec3 F = fresnelSchlick(NoV, F0);

    vec3 diffuseWeight = (vec3(1.0) - F) * (1.0 - metallic) * material.albedo;
    vec3 specularWeight = F;
    float diffuseEnergy = luminance(diffuseWeight);
    float specularEnergy = luminance(specularWeight);
    float totalEnergy = diffuseEnergy + specularEnergy;
    if (totalEnergy <= EPSILON) {
        return false;
    }
    float specularProbability = clamp(specularEnergy / totalEnergy, 0.05, 0.95);
    if (randomFloat() < specularProbability) {
        vec3 reflected = reflect(normalize(rayIn.direction), rec.normal);
        float spread = roughness * roughness;
        vec3 direction = normalize(reflected + spread * randomUnitVector());
        if (dot(direction, rec.normal) <= 0.0) {
            return false;
        }
        scattered = Ray(rec.p, direction);
        attenuation = specularWeight / specularProbability;
        return true;
    }
    vec3 scatterDirection = rec.normal + randomUnitVector();
    if (nearZero(scatterDirection)) {
        scatterDirection = rec.normal;
    }
    scattered = Ray(rec.p, scatterDirection);
    attenuation = diffuseWeight / (1.0 - specularProbability);
    return true;
}


bool scatterMaterial(in Ray rayIn, in HitRecord rec, out vec3 attenuation, out Ray scattered, Material material) {
    if (material.type == MATERIAL_LAMBERTIAN){
        return scatterLambertian(rayIn, rec, material, attenuation, scattered); }
    else if (material.type == MATERIAL_METAL) {
        return scatterMetal(rayIn, rec, material, attenuation, scattered); }
    else if (material.type == MATERIAL_DIELECTRIC) {
        return scatterDielectric(rayIn, rec, material, attenuation, scattered);
    } else if (material.type == MATERIAL_PBR_METAL_ROUGH) {
        return scatterPbrMetallicRoughness(rayIn, rec, material, attenuation, scattered);
    }
    return false;
}
vec3 rayAt(Ray r, float t) {
    return r.origin + t * r.direction;
}

Sphere loadSphere(int index) {
    PackedSphere packed = sphereBuffer[index];
    Sphere sphere;
    sphere.center = packed.centerRadius.xyz;
    sphere.radius = packed.centerRadius.w;
    sphere.material = packed.metadata.x;
    return sphere;
}
//todo fix hitsphere to use buffer
bool hitAabb(PackedBvhNode node, Ray ray, vec3 inverseDirection, float rayTMin, float rayTMax, out float entryT) {
    vec3 t0 = (node.boundsMin.xyz - ray.origin) * inverseDirection;
    vec3 t1 = (node.boundsMax.xyz - ray.origin) * inverseDirection;
    vec3 nearT = min(t0, t1);
    vec3 farT = max(t0, t1);
    float currentMin = max(rayTMin, max(nearT.x, max(nearT.y, nearT.z)));
    float currentMax = min(rayTMax, min(farT.x, min(farT.y, farT.z)));
    entryT = currentMin;
    return currentMax >= currentMin;
}
bool hitSphere(Sphere sphere, Ray r, Interval rT, out HitRecord record) {
    vec3 oc = r.origin - sphere.center;
    float a = dot(r.direction, r.direction);
    float h = dot(oc, r.direction);
    float c = dot(oc, oc) - sphere.radius * sphere.radius;
    float discriminant = h * h - a * c;
    if (discriminant < 0.0) {
        return false;
    }
    float sqrtDiscriminant = sqrt(discriminant);
    float root = (-h - sqrtDiscriminant) / a;
    if (!intervalSurrounds(rT, root)) {
        root = (-h + sqrtDiscriminant) / a;
        if (!intervalSurrounds(rT, root)) {
            return false;
        }
    }
    record.t = root;
    record.p = rayAt(r, record.t);
    vec3 outwardNormal = (record.p - sphere.center) / sphere.radius;
    setFaceNormal(r, outwardNormal, record);
    record.material = sphere.material;
    return true;
}
bool hitQuad(int quadIndex, Ray r, Interval rT, out HitRecord record) {
    PackedQuad quad = quadBuffer[quadIndex];
    vec3 Q = quad.Q.xyz;
    vec3 u = quad.u.xyz;
    vec3 v = quad.v.xyz;
    vec3 n =
    cross(u, v);
    float nLengthSquared = dot(n, n);
    if (nLengthSquared < EPSILON) {
        return false;
    }
    vec3 normal = n / sqrt(nLengthSquared);
    float denom = dot(normal, r.direction);

    if (abs(denom) < EPSILON) {
        return false;
    }
    float D = dot(normal, Q);
    float t = (D - dot(normal, r.origin)) / denom;
    if (!intervalSurrounds(rT, t)){
        return false;
    }
    vec3 intersection = rayAt(r, t);
    vec3 planarHit = intersection - Q;
    vec3 w = n / nLengthSquared;
    float alpha = dot(w, cross(planarHit, v));
    float beta = dot(w, cross(u, planarHit));
    if (alpha < 0.0 || alpha > 1.0 || beta < 0.0 || beta > 1.0){
        return false;
    }
    record.t = t;
    record.p = intersection;
    record.material = quad.metadata.x;
    setFaceNormal(r, normal, record);
    return true;
}
bool hitTri(int triIndex, Ray r, Interval rT, out HitRecord record) {
    PackedTriangle tri = triangleBuffer[triIndex];
    vec3 Q = tri.Q.xyz;
    vec3 U = tri.U.xyz;
    vec3 V = tri.V.xyz;
    vec3 edge1 = U - Q;
    vec3 edge2 = V - Q;

    vec3 normal = normalize(cross(edge1, edge2));
    vec3 h = cross(r.direction, edge2);
    float det = dot(edge1, h);
    if (abs(det) < EPSILON) {
        return false;
    }
    float inv_det = 1.0 / det;
    vec3 s = r.origin - Q;
    float u = inv_det * dot(s, h);
    if (u < EPSILON || u - 1 > EPSILON) {
        return false;
    }
    vec3 q = cross(s, edge1);
    float v = inv_det * dot(r.direction, q);
    if (v < -EPSILON || u + v - 1 > EPSILON) {
        return false;
    }
    float t = inv_det * dot(edge2, q);
    if (!intervalSurrounds(rT, t)) {
        return false;
    }
    record.t = t;
    record.p = rayAt(r, t);
    record.material = tri.metadata.x;
    setFaceNormal(r, normal, record);
    return true;
}

bool hitMeshTri(int triIndex, Ray r, Interval rT, out HitRecord record) {
    PackedMeshTriangle tri = meshTriangleBuffer[triIndex];
    int index0 = tri.metadata.x;
    int index1 = tri.metadata.y;
    int index2 = tri.metadata.z;

    vec3 a = meshVertexBuffer[index0].position.xyz;
    vec3 b = meshVertexBuffer[index1].position.xyz;
    vec3 c = meshVertexBuffer[index2].position.xyz;

    vec3 edge1 = b - a;
    vec3 edge2 = c - a;
    vec3 p = cross(r.direction, edge2);
    float determinant = dot(edge1, p);
    if (abs(determinant) < EPSILON) {
        return false;
    }

    float inverseDeterminant =  1.0 / determinant;

    vec3 s = r.origin - a;
    float u = inverseDeterminant * dot(s, p);
    if (u < 0.0 || u > 1.0) {
        return false;
    }

    vec3 q = cross(s, edge1);
    float v = inverseDeterminant * dot(r.direction, q);
    if (v < 0.0 || u + v > 1.0) {
        return false;
    }
    float t = inverseDeterminant * dot(edge2, q);
    if (!intervalSurrounds(rT, t)) {
        return false;
    }
    record.t = t;
    record.p = rayAt(r, t);
    record.material = tri.metadata.w;

    float w = 1.0 - u - v;
    vec3 n0 = meshVertexBuffer[index0].normal.xyz;
    vec3 n1 = meshVertexBuffer[index1].normal.xyz;
    vec3 n2 = meshVertexBuffer[index2].normal.xyz;
    vec3 interpolatedNormal = w * n0 + u * n1 + v * n2;
    vec3 outwardNormal;

    if (dot(interpolatedNormal, interpolatedNormal) > EPSILON) {
        outwardNormal = normalize(interpolatedNormal);
    }
    else {
        outwardNormal = normalize(cross(edge1, edge2));
    }
    setFaceNormal(r, outwardNormal, record);
    return true;
}
bool hitMesh(int meshIndex, Ray localRay, Interval rT, out HitRecord record) {
    PackedMesh mesh = meshBuffer[meshIndex];
    int rootNode = mesh.metadata.x;
    bool hitAnything = false;
    float closestSoFar = rT.max;

    HitRecord temporaryRecord;
    vec3 inverseDirection = 1.0 / localRay.direction;
    float rootEntryT;
    if (!hitAabb(blasNodeBuffer[rootNode], localRay, inverseDirection, rT.min, closestSoFar, rootEntryT)) {
        return false;
    }

    int stack[BLAS_STACK_SIZE];
    int stackSize = 0;
    stack[stackSize++] = rootNode;

    while (stackSize > 0) {
        int nodeIndex = stack[--stackSize];
        PackedBvhNode node = blasNodeBuffer[nodeIndex];
        bool isLeaf = node.metadata.z != 0;
        if (isLeaf) {
            int firstTriangle = node.metadata.x;
            int triangleCount = node.metadata.y;
            for (int triangleOffset = 0; triangleOffset < triangleCount; ++triangleOffset) {
                int triangleIndex = firstTriangle + triangleOffset;
                if (hitMeshTri(triangleIndex, localRay, Interval(rT.min, closestSoFar), temporaryRecord)) {
                    hitAnything = true;
                    closestSoFar = temporaryRecord.t;
                    record = temporaryRecord;
                }
            }
            continue;
        }

        int leftChild = node.metadata.x;
        int rightChild = node.metadata.y;
        float leftEntryT;
        float rightEntryT;
        bool hitLeft = hitAabb(blasNodeBuffer[leftChild], localRay, inverseDirection, rT.min, closestSoFar, leftEntryT);
        bool hitRight = hitAabb(blasNodeBuffer[rightChild], localRay, inverseDirection, rT.min, closestSoFar, rightEntryT);
        if (hitLeft && hitRight) {
            /*
             * Push farther child first so the nearer
             * child is popped first.
             */
            if (leftEntryT < rightEntryT) {
                stack[stackSize++] = rightChild;
                stack[stackSize++] = leftChild;
            } else {
                stack[stackSize++] = leftChild;
                stack[stackSize++] = rightChild;
            }
        } else if (hitLeft){
            stack[stackSize++] = leftChild;
        } else if (hitRight) {
            stack[stackSize++] = rightChild;
        }
    }
    return hitAnything;
}

bool hitLocalPrimitive(int primitiveType, int primitiveIndex, Ray r, Interval rT, out HitRecord record) {
    if (primitiveType == PRIMITIVE_SPHERE) {
        return false;
    } else if (primitiveType == PRIMITIVE_QUAD) {
        return hitQuad(primitiveIndex, r, rT, record);
    } else if (primitiveType == PRIMITIVE_TRI) {
        return hitTri(primitiveIndex, r, rT, record);
    } else if (primitiveType == PRIMITIVE_MESH) {
        return hitMesh(primitiveIndex, r, rT, record);
    }
    return false;
}
bool hitPrimitive(PackedPrimitiveRef primitiveRef, Ray r, Interval rT, out HitRecord record) {
    int primitiveType = primitiveRef.metadata.x;
    int primitiveIndex = primitiveRef.metadata.y;
    int transformIndex = primitiveRef.metadata.z;
    if (transformIndex == 0) {
        return hitLocalPrimitive(primitiveType, primitiveIndex, r, rT,record);
    }

    mat4 worldToObject = transformBuffer[transformIndex].worldToObject;
    Ray localRay;
    localRay.origin = (worldToObject * vec4(r.origin, 1.0)).xyz;
    localRay.direction = (worldToObject * vec4(r.direction, 0.0)).xyz;

    HitRecord localRecord;
    if (!hitLocalPrimitive(primitiveType, primitiveIndex, localRay, rT, localRecord)) {
        return false;
    }
    record = localRecord;
    record.p = rayAt(r, localRecord.t);
    vec3 localOutwardNormal = localRecord.frontFace ? localRecord.normal : -localRecord.normal;
    mat3 normalToWorld = transpose(mat3(worldToObject));
    vec3 worldOutwardNormal = normalize(normalToWorld * localOutwardNormal);
    setFaceNormal(r, worldOutwardNormal, record);
    return true;
}
bool hitWorld(Ray ray, Interval rayT, out HitRecord record) {
    if (uTlasNodeCount <= 0) {
        return false;
    }
    bool hitAnything = false;
    float closestSoFar = rayT.max;
    HitRecord temporaryRecord;
    float rootEntryT;
    vec3 inverseDirection = 1.0 / ray.direction;
    if (!hitAabb(tlasNodeBuffer[0], ray, inverseDirection, rayT.min, closestSoFar, rootEntryT)) {
        return false;
    }

    int stack[TLAS_STACK_SIZE];
    int stackSize = 0;
    stack[stackSize++] = 0;

    while (stackSize > 0) {
        int nodeIndex =
        stack[--stackSize];

        PackedBvhNode node = tlasNodeBuffer[nodeIndex];
        bool isLeaf = node.metadata.z != 0;

        if (isLeaf) {
            int firstPrimitive = node.metadata.x;
            int primitiveCount = node.metadata.y;

            for (int primitiveOffset = 0; primitiveOffset < primitiveCount; ++primitiveOffset) {
                int primitiveRefIndex = firstPrimitive + primitiveOffset;
                PackedPrimitiveRef primitiveRef = primitiveRefBuffer[primitiveRefIndex];
                if (hitPrimitive(primitiveRef, ray, Interval(rayT.min, closestSoFar), temporaryRecord)) {
                    hitAnything = true;
                    closestSoFar = temporaryRecord.t;
                    record = temporaryRecord;
                }
            }
            continue;
        }
        int leftChild = node.metadata.x;
        int rightChild = node.metadata.y;
        PackedBvhNode leftNode = tlasNodeBuffer[leftChild];
        PackedBvhNode rightNode = tlasNodeBuffer[rightChild];
        float leftEntryT;
        float rightEntryT;
        bool hitLeft = hitAabb(leftNode, ray, inverseDirection, rayT.min, closestSoFar, leftEntryT);
        bool hitRight = hitAabb(rightNode, ray, inverseDirection, rayT.min, closestSoFar, rightEntryT);

        if (hitLeft && hitRight) {
            if (leftEntryT < rightEntryT) {
                stack[stackSize++] = rightChild;
                stack[stackSize++] = leftChild;
            }
            else {
                stack[stackSize++] = leftChild;
                stack[stackSize++] = rightChild;
            }
        }
        else if (hitLeft) {
            stack[stackSize++] = leftChild;
        }
        else if (hitRight) {
            stack[stackSize++] = rightChild;
        }
    }
    return hitAnything;
}

vec2 directionToEnvironmentUv(vec3 direction) {
    vec3 d = normalize(direction);
    float phi = atan(d.z, d.x) + uEnvironmentRotation.y;
    float theta = acos(clamp(d.y, -1.0, 1.0));
    float u = fract(phi / TWO_PI + 0.5);
    float v = theta / PI;
    return vec2(u, v);
}
vec3 sampleEnvironment(vec3 direction) {
    vec2 uv = directionToEnvironmentUv(direction);
    vec3 radiance = textureLod(uEnvironmentMap, uv, 0.0).rgb;
    return radiance * uEnvironmentIntensity;
}
vec3 skyBoxColor(Ray r) {
    if (uUseHdri) {
        return sampleEnvironment(r.direction);
    }
    vec3 unitDirection = normalize(r.direction);
    float blend = 0.5 * (unitDirection.y + 1.0);
    return mix( uSkyColor1, uSkyColor2, blend);
}
vec3 rayColor(Ray r) {
    Ray currentRay = r;
    vec3 throughput = vec3(1.0, 1.0, 1.0);
    vec3 radiance = vec3(0.0);
    for (int bounce = 0; bounce < MAX_DEPTH; ++bounce) {
        HitRecord rec;
        if (hitWorld(currentRay, Interval(0.001, MAX_RAY_DISTANCE), rec)) {
            Material material = loadMaterial(rec.material);
            radiance += throughput * emitted(material);
            Ray scattered;
            vec3 attenuation;
            if (!scatterMaterial(currentRay, rec, attenuation, scattered, material)){
                break;
            }
            throughput *= attenuation;
            currentRay = scattered;
        }
        else {
            radiance += throughput * skyBoxColor(currentRay);
            return radiance;
        }
    }
    return radiance;
}

Camera makeCamera(ivec2 imageDimensions) {
    Camera camera;
    camera.center = uCameraLookFrom;
    float imageWidth = float(imageDimensions.x);
    float imageHeight = float(imageDimensions.y);
    float aspectRatio = imageWidth / imageHeight;

    /*
     * Camera coordinate basis.
     *
     * w points backward from the target toward the camera.
     * u points camera-right.
     * v points camera-up.
     */
    vec3 w = normalize(uCameraLookFrom - uCameraLookAt);

    vec3 u = normalize(cross(uCameraVUp, w));

    vec3 v = cross(w, u);

    /*
     * The viewport lies on the focal plane.
     */
    float theta = radians(uCameraVerticalFov);

    float viewportHeight = 2.0 * tan(theta * 0.5) * uCameraFocusDistance;

    float viewportWidth = viewportHeight * aspectRatio;

    vec3 viewportU = viewportWidth * u;

    /*
     * Negative v makes image rows progress from top to bottom,
     * matching RTIOW's camera construction.
     */
    vec3 viewportV = viewportHeight * v;

    camera.pixel_delta_u = viewportU / imageWidth;

    camera.pixel_delta_v = viewportV / imageHeight;

    vec3 viewportUpperLeft = camera.center - uCameraFocusDistance * w - viewportU * 0.5 - viewportV * 0.5;

    camera.pixel00_loc = viewportUpperLeft + 0.5 * (camera.pixel_delta_u + camera.pixel_delta_v);

    /*
     * Construct the lens disk in camera-space.
     */
    float defocusRadius = uCameraFocusDistance * tan(radians(uCameraDefocusAngle * 0.5));

    camera.defocus_disc_u = u * defocusRadius;

    camera.defocus_disc_v = v * defocusRadius;

    return camera;
}
vec3 defocusDiskSample(Camera camera)
{
    vec2 p =
    randomInUnitDisk();

    return camera.center
    + p.x * camera.defocus_disc_u
    + p.y * camera.defocus_disc_v;
}

Ray getCameraRay(Camera camera, ivec2 pixel)
{
    vec2 offset = sampleSquare();
    vec3 pixelSample = camera.pixel00_loc + (float(pixel.x) + offset.x)
    * camera.pixel_delta_u + (float(pixel.y) + offset.y) * camera.pixel_delta_v;

    vec3 rayOrigin;
    if (uCameraDefocusAngle <= 0.0) {
        rayOrigin = camera.center;
    } else {
        rayOrigin = defocusDiskSample(camera);
    }

    Ray ray;
    ray.origin = rayOrigin;
    ray.direction = pixelSample - rayOrigin;
    return ray;
}
/*
 * main loop
 */
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageDimensions = imageSize(outputImage);
    if (pixel.x >= imageDimensions.x || pixel.y >= imageDimensions.y) {
        return;
    }

    /*
 * Seed this invocation's random stream.
 */
    uint pixelIndex = uint(pixel.x) + uint(pixel.y) * uint(imageDimensions.x);
    rngState = pcgHash(pcgHash(pixelIndex + 1u) ^ pcgHash(uFrameIndex + 1u));

    //    Camera camera;
    Camera camera = makeCamera(imageDimensions);

    vec3 color = vec3(0.0);

    for (int sampleIndex = 0; sampleIndex < SAMPLES_PER_DISPATCH; ++sampleIndex) {
        Ray ray = getCameraRay(camera, pixel);
        color += rayColor(ray);
    }

    vec3 currentColor = color / float(SAMPLES_PER_DISPATCH);

    vec3 accumulatedAverageColor;

    if (uFrameIndex == 0u) {
        accumulatedAverageColor = currentColor;
    } else {
        vec3 previousAverageColor = imageLoad(outputImage, pixel).rgb;
        float previousFrameCount = float(uFrameIndex);
        accumulatedAverageColor = (previousAverageColor * previousFrameCount + currentColor) / (previousFrameCount + 1.0);
    }
//    finalColor = sqrt(max(finalColor, vec3(0.0)));
    imageStore(outputImage, pixel, vec4(accumulatedAverageColor, 1.0));
}