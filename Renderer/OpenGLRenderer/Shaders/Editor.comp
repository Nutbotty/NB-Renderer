struct Material {
    int type;

    vec3 albedo;
    float opacity;

    float metallic;
    float roughness;
    float refractionIndex;
    float transmission;

    vec3 emission;
    float emissionStrength;

    float fuzz;
};

struct Ray {
    vec3 origin;
    vec3 direction;
};

vec3 transformPoint(mat4 transform, vec3 point) {
    return (transform * vec4(point, 1.0)).xyz;
}
vec3 transformVector(mat4 transform, vec3 vector) {
    return (transform * vec4(vector, 0.0)).xyz;
}
Ray transformRay(mat4 transform, Ray ray) {
    Ray transformed;
    transformed.origin = transformPoint(transform, ray.origin);
    transformed.direction = transformVector(transform, ray.direction);
    return transformed;
}

Material loadMaterial(int index) {
    PackedMaterial packed = materialBuffer[index];
    Material material;
    material.type = packed.metadata.x;

    material.albedo = packed.baseColor.rgb;
    material.opacity = packed.baseColor.a;

    material.metallic = packed.surface.x;
    material.roughness = packed.surface.y;
    material.refractionIndex = packed.surface.z;
    material.transmission = packed.surface.w;

    material.emission = packed.emission.xyz;
    material.emissionStrength = packed.emission.w;
//    material.refractionIndex = packed.optical.x;

//    material.albedo = packed.albedoFuzz.xyz;
//    material.fuzz = packed.albedoFuzz.w;
    return material;
}

